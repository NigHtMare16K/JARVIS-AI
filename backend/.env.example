# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jarvis

# JWT
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq LLM
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7
MAX_HISTORY_MESSAGES=12

# Tavily Web Search
TAVILY_API_KEY=your-tavily-api-key

# RAG
RAG_TOP_K=4
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Voice / VAD
SPEECH_ENERGY_THRESHOLD=0.015
SILENCE_DURATION_SEC=1.2
MAX_UTTERANCE_DURATION_SEC=30.0
PRE_SPEECH_BUFFER_SEC=0.3
CONVERSATION_IDLE_TIMEOUT_SEC=120.0
MAX_SILENT_TURNS=2

# Wake Word
WAKE_WORD=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# CORS (frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
